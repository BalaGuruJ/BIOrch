{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "tables": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {"type": "string"},
          "name": {"type": "string"},
          "annotations": {"type": "array", "items": {"type": "object", "properties": {"name": {"type": "string"}, "value": {"type": "string"}}}},
          "lineage_metadata": {"type": ["string", "null"]},
          "provenance": {"type": ["object", "null"], "properties": {"source_type": {"type": "string"}, "expression": {"type": ["string", "null"]}}}
        },
        "required": ["id", "name"]
      }
    },
    "columns": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {"type": "string"},
          "name": {"type": "string"},
          "table_id": {"type": "string"},
          "data_type": {"type": "string"},
          "is_calculated": {"type": "boolean"},
          "expression": {"type": ["string", "null"]},
          "annotations": {"type": "array", "items": {"type": "object", "properties": {"name": {"type": "string"}, "value": {"type": "string"}}}},
          "lineage_metadata": {"type": ["string", "null"]},
          "provenance": {"type": ["object", "null"], "properties": {"source_type": {"type": "string"}, "expression": {"type": ["string", "null"]}}}
        },
        "required": ["id", "name", "table_id", "data_type", "is_calculated"]
      }
    },
    "measures": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {"type": "string"},
          "name": {"type": "string"},
          "table_id": {"type": "string"},
          "expression": {"type": "string"},
          "annotations": {"type": "array", "items": {"type": "object", "properties": {"name": {"type": "string"}, "value": {"type": "string"}}}},
          "lineage_metadata": {"type": ["string", "null"]},
          "provenance": {"type": ["object", "null"], "properties": {"source_type": {"type": "string"}, "expression": {"type": ["string", "null"]}}}
        },
        "required": ["id", "name", "table_id", "expression"]
      }
    },
    "relationships": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {"type": "string"},
          "from_table_id": {"type": "string"},
          "from_column_id": {"type": "string"},
          "to_table_id": {"type": "string"},
          "to_column_id": {"type": "string"},
