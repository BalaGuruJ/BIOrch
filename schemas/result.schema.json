{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Result",
  "type": "object",
  "properties": {
    "task_id": {
      "type": "string",
      "description": "The ID of the task this result belongs to."
    },
    "status": {
      "type": "string",
      "enum": ["success", "failure", "partial"],
      "description": "The outcome of the task."
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      },
      "description": "Structured data extracted or generated by the agent."
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "List of file paths or URIs created/modified by the task."
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "List of error messages if the task failed or had partial success."
    },
    "metadata": {
      "type": "object",
      "description": "Execution metrics or other metadata.",
      "additionalProperties": true
    }
  },
  "required": ["task_id", "status"]
}